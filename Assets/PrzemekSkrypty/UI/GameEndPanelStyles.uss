/* ============================================
   GAME END PANEL — ART DECO VICTORY / DEFEAT
   Full-screen overlay with staged reveal
   ============================================ */

/* ============================================
   ROOT OVERLAY
   ============================================ */

.endgame-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.8s;
    transition-timing-function: ease-in;
}

.endgame-root-visible {
    background-color: rgba(5, 8, 16, 0.92);
}

/* ============================================
   VIGNETTE BORDER GLOW
   ============================================ */

.endgame-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: border-color;
    transition-duration: 1.2s;
}

.endgame-vignette-victory {
    border-color: rgba(245, 158, 11, 0.15);
}

.endgame-vignette-defeat {
    border-color: rgba(248, 113, 113, 0.08);
}

/* ============================================
   CORNER DECORATIONS (art deco L-brackets)
   ============================================ */

.endgame-corner {
    position: absolute;
    width: 60px;
    height: 60px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-delay: 0.4s;
}

.endgame-root-visible .endgame-corner {
    opacity: 1;
}

.endgame-corner-tl {
    left: 24px;
    top: 24px;
    border-left-width: 2px;
    border-top-width: 2px;
}

.endgame-corner-tr {
    right: 24px;
    top: 24px;
    border-right-width: 2px;
    border-top-width: 2px;
}

.endgame-corner-bl {
    left: 24px;
    bottom: 24px;
    border-left-width: 2px;
    border-bottom-width: 2px;
}

.endgame-corner-br {
    right: 24px;
    bottom: 24px;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.endgame-corner-victory {
    border-color: rgba(245, 158, 11, 0.25);
}

.endgame-corner-defeat {
    border-color: rgba(248, 113, 113, 0.15);
}

/* Inner corners (smaller, offset) */
.endgame-corner-inner {
    position: absolute;
    width: 35px;
    height: 35px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-delay: 0.6s;
}

.endgame-root-visible .endgame-corner-inner {
    opacity: 1;
}

.endgame-corner-inner-tl {
    left: 36px;
    top: 36px;
    border-left-width: 1px;
    border-top-width: 1px;
}

.endgame-corner-inner-tr {
    right: 36px;
    top: 36px;
    border-right-width: 1px;
    border-top-width: 1px;
}

.endgame-corner-inner-bl {
    left: 36px;
    bottom: 36px;
    border-left-width: 1px;
    border-bottom-width: 1px;
}

.endgame-corner-inner-br {
    right: 36px;
    bottom: 36px;
    border-right-width: 1px;
    border-bottom-width: 1px;
}

.endgame-corner-inner-victory {
    border-color: rgba(245, 158, 11, 0.12);
}

.endgame-corner-inner-defeat {
    border-color: rgba(248, 113, 113, 0.08);
}

/* ============================================
   RADIAL LINES (background decoration)
   ============================================ */

.endgame-radial-origin {
    position: absolute;
    left: 50%;
    top: 35%;
    width: 0;
    height: 0;
    overflow: visible;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.5s;
    transition-delay: 0.3s;
}

.endgame-root-visible .endgame-radial-origin {
    opacity: 1;
}

.endgame-radial-line {
    position: absolute;
    width: 900px;
    height: 1px;
    left: -450px;
    top: 0;
    transform-origin: center center;
}

.endgame-radial-line-victory {
    background-color: rgba(245, 158, 11, 0.04);
}

.endgame-radial-line-defeat {
    background-color: rgba(248, 113, 113, 0.025);
}

/* ============================================
   MAIN CONTENT CONTAINER
   ============================================ */

.endgame-content {
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 40px 60px;
    max-width: 700px;
}

/* ============================================
   TOP ORNAMENT
   ============================================ */

.endgame-ornament-top {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-delay: 0.5s;
}

.endgame-root-visible .endgame-ornament-top {
    opacity: 1;
}

.endgame-ornament-line {
    height: 2px;
    width: 80px;
}

.endgame-ornament-line-victory {
    background-color: rgba(245, 158, 11, 0.4);
}

.endgame-ornament-line-defeat {
    background-color: rgba(248, 113, 113, 0.25);
}

.endgame-ornament-diamond {
    width: 14px;
    height: 14px;
    border-width: 2px;
    rotate: 45deg;
    scale: 0.7 0.7;
    margin-left: 12px;
    margin-right: 12px;
}

.endgame-ornament-diamond-victory {
    border-color: rgb(245, 158, 11);
    background-color: rgba(245, 158, 11, 0.15);
}

.endgame-ornament-diamond-defeat {
    border-color: rgba(248, 113, 113, 0.6);
    background-color: rgba(248, 113, 113, 0.08);
}

.endgame-ornament-diamond-center {
    width: 18px;
    height: 18px;
    border-width: 2px;
    rotate: 45deg;
    scale: 0.7 0.7;
    margin-left: 8px;
    margin-right: 8px;
}

.endgame-ornament-diamond-center-victory {
    border-color: rgb(217, 119, 6);
    background-color: rgb(180, 83, 9);
}

.endgame-ornament-diamond-center-defeat {
    border-color: rgba(248, 113, 113, 0.5);
    background-color: rgba(220, 38, 38, 0.3);
}

/* ============================================
   TITLE — VICTORY
   Glowing golden text, triumphant
   ============================================ */

.endgame-title {
    font-size: 64px;
    letter-spacing: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 4px;
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale, color;
    transition-duration: 0.7s, 0.7s, 1s;
    transition-delay: 0.6s, 0.6s, 0.6s;
    transition-timing-function: ease-out;
}

.endgame-root-visible .endgame-title {
    opacity: 1;
    scale: 1 1;
}

.endgame-title-victory {
    color: rgb(252, 211, 77);
}

.endgame-title-defeat {
    color: rgb(180, 60, 60);
    letter-spacing: 28px;
}

/* Title glow backdrop (victory only) */
.endgame-title-glow {
    position: absolute;
    width: 400px;
    height: 100px;
    border-radius: 50px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
    transition-delay: 0.8s;
    translate: 0 -10px;
}

.endgame-title-glow-victory {
    background-color: rgba(245, 158, 11, 0.06);
}

.endgame-root-visible .endgame-title-glow {
    opacity: 1;
}

/* ============================================
   SUBTITLE
   ============================================ */

.endgame-subtitle {
    font-size: 12px;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    margin-bottom: 32px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-delay: 0.9s;
}

.endgame-root-visible .endgame-subtitle {
    opacity: 1;
}

.endgame-subtitle-victory {
    color: rgba(217, 119, 6, 0.7);
}

.endgame-subtitle-defeat {
    color: rgba(248, 113, 113, 0.4);
}

/* ============================================
   DEFEAT SCAR LINES (decorative "damage")
   ============================================ */

.endgame-scar-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.endgame-scar {
    position: absolute;
    background-color: rgba(220, 38, 38, 0.08);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.endgame-root-visible .endgame-scar {
    opacity: 1;
}

.endgame-scar-1 {
    width: 200px;
    height: 1px;
    top: 30%;
    left: 10%;
    rotate: -15deg;
    transition-delay: 1.0s;
}

.endgame-scar-2 {
    width: 160px;
    height: 1px;
    top: 32%;
    left: 12%;
    rotate: -12deg;
    transition-delay: 1.1s;
}

.endgame-scar-3 {
    width: 180px;
    height: 1px;
    bottom: 28%;
    right: 8%;
    rotate: 10deg;
    transition-delay: 1.2s;
}

.endgame-scar-4 {
    width: 120px;
    height: 1px;
    bottom: 30%;
    right: 10%;
    rotate: 14deg;
    transition-delay: 1.3s;
}

/* ============================================
   DIVIDER
   ============================================ */

.endgame-divider {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-delay: 1.0s;
}

.endgame-root-visible .endgame-divider {
    opacity: 1;
}

.endgame-divider-line {
    width: 60px;
    height: 1px;
}

.endgame-divider-line-victory {
    background-color: rgba(245, 158, 11, 0.2);
}

.endgame-divider-line-defeat {
    background-color: rgba(248, 113, 113, 0.12);
}

.endgame-divider-dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    margin-left: 12px;
    margin-right: 12px;
}

.endgame-divider-dot-victory {
    background-color: rgba(245, 158, 11, 0.4);
}

.endgame-divider-dot-defeat {
    background-color: rgba(248, 113, 113, 0.25);
}

/* ============================================
   STATS SECTION (XP + Level)
   ============================================ */

.endgame-stats-section {
    width: 100%;
    align-items: center;
    margin-bottom: 20px;
    opacity: 0;
    translate: 0 20px;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-delay: 1.1s;
    transition-timing-function: ease-out;
}

.endgame-root-visible .endgame-stats-section {
    opacity: 1;
    translate: 0 0;
}

.endgame-stats-panel {
    width: 100%;
    max-width: 440px;
    background-color: rgba(12, 18, 30, 0.7);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.1);
    padding: 20px 24px;
    flex-direction: column;
    overflow: hidden;
}

.endgame-stats-inner-border {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.04);
}

/* Level row */
.endgame-level-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.endgame-level-hexagon {
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
}

.endgame-level-hex-bg {
    position: absolute;
    width: 36px;
    height: 36px;
    background-color: rgba(245, 158, 11, 0.1);
    border-radius: 4px;
    rotate: 45deg;
    scale: 0.7 0.7;
}

.endgame-level-hex-border {
    position: absolute;
    width: 36px;
    height: 36px;
    border-width: 1px;
    border-color: rgb(245, 158, 11);
    border-radius: 4px;
    rotate: 45deg;
    scale: 0.7 0.7;
}

.endgame-level-number {
    font-size: 12px;
    color: rgb(254, 243, 199);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.endgame-level-label {
    font-size: 10px;
    color: rgba(245, 158, 11, 0.5);
    letter-spacing: 4px;
    margin-left: 10px;
}

.endgame-xp-gain {
    font-size: 14px;
    color: rgb(74, 222, 128);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

/* XP bar */
.endgame-xp-bar-container {
    flex-direction: column;
    width: 100%;
}

.endgame-xp-bar-bg {
    width: 100%;
    height: 6px;
    background-color: rgba(245, 158, 11, 0.08);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.06);
    overflow: hidden;
    margin-bottom: 4px;
}

.endgame-xp-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(245, 158, 11);
    transition-property: width;
    transition-duration: 1.2s;
    transition-timing-function: ease-out;
    transition-delay: 1.5s;
}

.endgame-xp-text {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.4);
    letter-spacing: 2px;
    -unity-text-align: upper-right;
}

/* ============================================
   RANKED SECTION (ELO + Rank)
   ============================================ */

.endgame-ranked-section {
    width: 100%;
    align-items: center;
    margin-bottom: 20px;
    opacity: 0;
    translate: 0 20px;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-delay: 1.3s;
    transition-timing-function: ease-out;
}

.endgame-root-visible .endgame-ranked-section {
    opacity: 1;
    translate: 0 0;
}

.endgame-ranked-panel {
    width: 100%;
    max-width: 440px;
    background-color: rgba(12, 18, 30, 0.7);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.1);
    padding: 20px 24px;
    flex-direction: column;
    overflow: hidden;
}

.endgame-ranked-inner-border {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.04);
}

.endgame-ranked-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.endgame-ranked-header-line {
    width: 30px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.15);
}

.endgame-ranked-header-label {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.35);
    letter-spacing: 5px;
    margin-left: 12px;
    margin-right: 12px;
}

/* Rank display */
.endgame-rank-display {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.endgame-rank-info {
    flex-direction: row;
    align-items: center;
}

.endgame-rank-icon-container {
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.endgame-rank-icon-bg {
    position: absolute;
    width: 40px;
    height: 40px;
    border-radius: 4px;
    rotate: 45deg;
    scale: 0.7 0.7;
}

.endgame-rank-icon-border {
    position: absolute;
    width: 40px;
    height: 40px;
    border-width: 1px;
    border-radius: 4px;
    rotate: 45deg;
    scale: 0.7 0.7;
}

.endgame-rank-icon-text {
    font-size: 16px;
    -unity-text-align: middle-center;
}

.endgame-rank-name {
    font-size: 18px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.endgame-elo-change {
    font-size: 20px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.endgame-elo-positive {
    color: rgb(74, 222, 128);
}

.endgame-elo-negative {
    color: rgb(248, 113, 113);
}

/* ELO progress bar */
.endgame-elo-bar-container {
    flex-direction: column;
    width: 100%;
}

.endgame-elo-bar-bg {
    width: 100%;
    height: 6px;
    background-color: rgba(245, 158, 11, 0.08);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.06);
    overflow: hidden;
    margin-bottom: 4px;
}

.endgame-elo-bar-fill {
    height: 100%;
    width: 0%;
    transition-property: width;
    transition-duration: 1.2s;
    transition-timing-function: ease-out;
    transition-delay: 1.8s;
}

.endgame-elo-fill-positive {
    background-color: rgb(74, 222, 128);
}

.endgame-elo-fill-negative {
    background-color: rgb(248, 113, 113);
}

.endgame-elo-bar-labels {
    flex-direction: row;
    justify-content: space-between;
}

.endgame-elo-rank-min {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.3);
    letter-spacing: 2px;
}

.endgame-elo-rank-max {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.3);
    letter-spacing: 2px;
}

/* ============================================
   QUEST RESULTS SECTION
   ============================================ */

.endgame-quests-section {
    width: 100%;
    align-items: center;
    margin-bottom: 24px;
    opacity: 0;
    translate: 0 20px;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-delay: 1.5s;
    transition-timing-function: ease-out;
}

.endgame-root-visible .endgame-quests-section {
    opacity: 1;
    translate: 0 0;
}

.endgame-quests-panel {
    width: 100%;
    max-width: 440px;
    background-color: rgba(12, 18, 30, 0.5);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.08);
    padding: 16px 20px;
    flex-direction: column;
    overflow: hidden;
}

.endgame-quests-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.endgame-quests-header-line {
    width: 24px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.12);
}

.endgame-quests-header-label {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.3);
    letter-spacing: 5px;
    margin-left: 10px;
    margin-right: 10px;
}

.endgame-quest-list {
    flex-direction: column;
}

/* Individual quest result */
.endgame-quest-slot {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin-bottom: 4px;
    background-color: rgba(12, 18, 30, 0.4);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.04);
}

.endgame-quest-tier-dot {
    width: 4px;
    min-height: 24px;
    margin-right: 10px;
    flex-shrink: 0;
}

.endgame-quest-tier-daily {
    background-color: rgba(74, 222, 128, 0.6);
}

.endgame-quest-tier-weekly {
    background-color: rgba(77, 128, 255, 0.7);
}

.endgame-quest-tier-special {
    background-color: rgba(249, 115, 22, 0.7);
}

.endgame-quest-info {
    flex-grow: 1;
    flex-direction: column;
}

.endgame-quest-desc {
    font-size: 11px;
    color: rgb(200, 210, 220);
    margin-bottom: 3px;
}

.endgame-quest-progress-row {
    flex-direction: row;
    align-items: center;
}

.endgame-quest-progress-bg {
    flex-grow: 1;
    height: 3px;
    background-color: rgba(245, 158, 11, 0.06);
    border-radius: 1px;
    overflow: hidden;
    margin-right: 8px;
}

.endgame-quest-progress-fill {
    height: 100%;
    border-radius: 1px;
    background-color: rgb(245, 158, 11);
}

.endgame-quest-progress-fill-complete {
    background-color: rgb(74, 222, 128);
}

.endgame-quest-progress-text {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.35);
    letter-spacing: 1px;
    flex-shrink: 0;
}

.endgame-quest-check {
    font-size: 14px;
    color: rgb(74, 222, 128);
    margin-left: 8px;
    flex-shrink: 0;
}

.endgame-quests-empty {
    font-size: 10px;
    color: rgba(245, 158, 11, 0.15);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    padding: 12px 0;
}

/* ============================================
   RETURN BUTTON
   ============================================ */

.endgame-button-section {
    align-items: center;
    opacity: 0;
    translate: 0 20px;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-delay: 1.7s;
    transition-timing-function: ease-out;
}

.endgame-root-visible .endgame-button-section {
    opacity: 1;
    translate: 0 0;
}

.endgame-return-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.35);
    color: rgba(245, 158, 11, 0.6);
    font-size: 12px;
    letter-spacing: 6px;
    padding: 14px 48px;
    cursor: link;
    transition-property: color, border-color, background-color, scale;
    transition-duration: 0.25s;
    border-radius: 0;
}

.endgame-return-button:hover {
    border-color: rgb(245, 158, 11);
    color: rgb(252, 211, 77);
    background-color: rgba(245, 158, 11, 0.06);
    scale: 1.03 1.03;
}

.endgame-return-button:active {
    color: rgb(254, 243, 199);
    background-color: rgba(245, 158, 11, 0.1);
}

/* Button accent lines */
.endgame-button-accent-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.endgame-button-accent-line {
    width: 24px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.12);
}

.endgame-button-accent-diamond {
    width: 6px;
    height: 6px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.2);
    rotate: 45deg;
    scale: 0.6 0.6;
    margin-left: 8px;
    margin-right: 8px;
}

/* ============================================
   HIDDEN
   ============================================ */

.hidden {
    display: none;
}

