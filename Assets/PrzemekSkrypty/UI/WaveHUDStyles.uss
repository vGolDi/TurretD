/* ============================================
   WAVE HUD — ART DECO
   Positioned top-center, between health panels
   Coexists with GameHUD & PlayerGoldHUD
   ============================================ */

.wave-hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
}

/* ============================================
   WAVE PANEL — Top center cluster
   Sits below gold HUD (top: ~55px)
   ============================================ */

.wave-panel-anchor {
    margin-top: 52px;
    align-items: center;
    flex-direction: column;
}

/* ============================================
   WAVE NUMBER BADGE
   ============================================ */

.wave-badge {
    flex-direction: row;
    align-items: center;
    padding: 8px 24px;
    background-color: rgba(10, 15, 26, 0.85);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.15);
    overflow: hidden;
    transition-property: border-color;
    transition-duration: 0.3s;
}

.wave-badge-inner-border {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.04);
}

.wave-badge-accent-left {
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 2px;
    background-color: rgba(245, 158, 11, 0.2);
}

.wave-badge-accent-right {
    position: absolute;
    right: 0;
    top: 20%;
    bottom: 20%;
    width: 2px;
    background-color: rgba(245, 158, 11, 0.2);
}

.wave-diamond {
    width: 8px;
    height: 8px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.3);
    rotate: 45deg;
    scale: 0.6 0.6;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgba(245, 158, 11, 0.06);
}

.wave-label {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.4);
    letter-spacing: 5px;
}

.wave-number {
    font-size: 14px;
    color: rgb(254, 243, 199);
    letter-spacing: 4px;
    -unity-font-style: bold;
    margin-left: 4px;
    margin-right: 4px;
    transition-property: color;
    transition-duration: 0.3s;
}

.wave-total {
    font-size: 10px;
    color: rgba(245, 158, 11, 0.3);
    letter-spacing: 2px;
    margin-left: 2px;
}

/* ============================================
   ENEMY PROGRESS BAR (below wave badge)
   Shows "spawned X of Y enemies"
   ============================================ */

.wave-progress-container {
    flex-direction: column;
    align-items: center;
    margin-top: 6px;
    width: 200px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.wave-progress-visible {
    opacity: 1;
}

.wave-progress-bar-bg {
    width: 100%;
    height: 3px;
    background-color: rgba(245, 158, 11, 0.06);
    overflow: hidden;
    margin-bottom: 3px;
}

.wave-progress-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgba(245, 158, 11, 0.35);
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.wave-progress-text {
    font-size: 9px;
    color: rgba(245, 158, 11, 0.25);
    letter-spacing: 3px;
}

/* ============================================
   COUNTDOWN OVERLAY
   Full-screen centered countdown
   ============================================ */

.countdown-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 16, 0.6);
    transition-property: opacity;
    transition-duration: 0.4s;
}

.countdown-container {
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.countdown-ornament-top {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.countdown-ornament-line {
    width: 60px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.25);
}

.countdown-ornament-diamond {
    width: 12px;
    height: 12px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.4);
    rotate: 45deg;
    scale: 0.7 0.7;
    margin-left: 12px;
    margin-right: 12px;
    background-color: rgba(245, 158, 11, 0.08);
}

.countdown-number {
    font-size: 96px;
    color: rgb(252, 211, 77);
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: scale, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.countdown-go {
    font-size: 64px;
    color: rgb(74, 222, 128);
    letter-spacing: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.countdown-sublabel {
    font-size: 10px;
    color: rgba(245, 158, 11, 0.35);
    letter-spacing: 6px;
    margin-top: 16px;
}

.countdown-ornament-bottom {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
}

.countdown-ornament-line-short {
    width: 30px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.15);
}

.countdown-ornament-diamond-small {
    width: 8px;
    height: 8px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.25);
    rotate: 45deg;
    scale: 0.6 0.6;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(245, 158, 11, 0.04);
}

/* ============================================
   WAVE ANNOUNCEMENT (between-wave flash)
   ============================================ */

.wave-announce-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color, opacity;
    transition-duration: 0.4s;
    opacity: 0;
}

.wave-announce-visible {
    background-color: rgba(5, 8, 16, 0.3);
    opacity: 1;
}

.wave-announce-container {
    align-items: center;
    flex-direction: column;
}

.wave-announce-ornament {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.wave-announce-ornament-line {
    width: 40px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.3);
}

.wave-announce-ornament-diamond {
    width: 10px;
    height: 10px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.5);
    rotate: 45deg;
    scale: 0.7 0.7;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgba(180, 83, 9, 0.3);
}

.wave-announce-title {
    font-size: 36px;
    color: rgb(254, 243, 199);
    letter-spacing: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.wave-announce-subtitle {
    font-size: 11px;
    color: rgba(245, 158, 11, 0.4);
    letter-spacing: 6px;
    margin-top: 6px;
}

/* ============================================
   ALL WAVES COMPLETE BANNER
   ============================================ */

.wave-complete-banner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.wave-complete-visible {
    opacity: 1;
}

.wave-complete-text {
    font-size: 24px;
    color: rgb(74, 222, 128);
    letter-spacing: 10px;
    -unity-font-style: bold;
}

.wave-complete-subtext {
    font-size: 10px;
    color: rgba(74, 222, 128, 0.4);
    letter-spacing: 5px;
    margin-top: 8px;
}

/* ============================================
   HIDDEN
   ============================================ */

.hidden {
    display: none;
}