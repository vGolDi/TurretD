/* ============================================
   MULTIPLAYER — ART DECO STYLE
   ============================================ */

.panel-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 15, 25);
    flex-direction: column;
    overflow: hidden;
}

/* Side decorations */
.side-decoration-left {
    position: absolute;
    left: 12px;
    top: 25%;
    bottom: 25%;
    width: 1px;
    background-color: rgba(245, 158, 11, 0.06);
}

.side-decoration-right {
    position: absolute;
    right: 12px;
    top: 25%;
    bottom: 25%;
    width: 1px;
    background-color: rgba(245, 158, 11, 0.06);
}

.side-tick-left {
    position: absolute;
    left: 12px;
    width: 16px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.08);
}

.side-tick-right {
    position: absolute;
    right: 12px;
    width: 16px;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.08);
}

/* Radial bg */
.mp-bg-radial {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
}

.mp-bg-radial-line {
    position: absolute;
    width: 1400px;
    height: 1px;
    left: -700px;
    top: 0;
    background-color: rgba(245, 158, 11, 0.03);
    transform-origin: center center;
}

/* ============================================
   HEADER
   ============================================ */

.panel-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 40px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(245, 158, 11, 0.12);
    flex-shrink: 0;
    background-color: rgba(8, 12, 20, 0.5);
}

.btn-back {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.3);
    color: rgba(245, 158, 11, 0.6);
    font-size: 12px;
    letter-spacing: 3px;
    padding: 10px 20px;
    margin-right: 24px;
    transition-property: color, border-color, background-color;
    transition-duration: 0.2s;
    border-radius: 0;
}

.btn-back:hover {
    color: rgb(252, 211, 77);
    border-color: rgb(245, 158, 11);
    background-color: rgba(245, 158, 11, 0.05);
}

.header-title-group { flex-direction: column; }

.panel-title {
    font-size: 26px;
    color: rgb(254, 243, 199);
    letter-spacing: 10px;
}

.panel-subtitle {
    font-size: 11px;
    color: rgba(245, 158, 11, 0.35);
    letter-spacing: 6px;
    margin-top: 2px;
}

.header-spacer { flex-grow: 1; }

/* ============================================
   CONTENT
   ============================================ */

.mp-content {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
}

/* ============================================
   RANK SECTION
   ============================================ */

.mp-rank-section {
    flex-direction: row;
    align-items: center;
    margin-bottom: 32px;
}

.mp-rank-hexagon {
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.mp-rank-hex-bg {
    position: absolute;
    width: 64px;
    height: 64px;
    background-color: rgba(245, 158, 11, 0.1);
    border-radius: 8px;
    rotate: 45deg;
    scale: 0.75 0.75;
}

.mp-rank-hex-border {
    position: absolute;
    width: 64px;
    height: 64px;
    border-width: 2px;
    border-color: rgba(245, 158, 11, 0.5);
    border-radius: 8px;
    rotate: 45deg;
    scale: 0.75 0.75;
}

.mp-rank-icon {
    font-size: 20px;
    color: rgb(254, 243, 199);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mp-rank-info { flex-direction: column; }

.mp-rank-name {
    font-size: 22px;
    color: rgb(254, 243, 199);
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.mp-elo-value {
    font-size: 12px;
    color: rgba(245, 158, 11, 0.4);
    letter-spacing: 3px;
    margin-top: 4px;
}

/* ============================================
   DIVIDER
   ============================================ */

.mp-divider-section {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 500px;
    margin-bottom: 40px;
}

.mp-divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(245, 158, 11, 0.1);
}

.mp-divider-diamond {
    width: 10px;
    height: 10px;
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.25);
    rotate: 45deg;
    scale: 0.7 0.7;
    margin-left: 6px;
    margin-right: 6px;
}

.mp-divider-diamond-center {
    width: 14px;
    height: 14px;
    background-color: rgba(245, 158, 11, 0.08);
    border-color: rgba(245, 158, 11, 0.35);
}

/* ============================================
   MODE CARDS
   ============================================ */

.mp-modes-container {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.mp-mode-card {
    width: 220px;
    height: 320px;
    background-color: rgb(12, 18, 30);
    border-width: 1px;
    border-color: rgba(146, 64, 14, 0.4);
    margin: 0 16px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    transition-property: border-color, scale, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    padding: 20px 0;
}

.mp-mode-card:hover {
    scale: 1.05 1.05;
    translate: 0 -12px;
    border-color: rgb(245, 158, 11);
}

/* Inner border */
.mp-mode-inner-border {
    position: absolute;
    left: 8px;
    top: 8px;
    right: 8px;
    bottom: 8px;
    border-width: 1px;
    border-color: rgba(120, 53, 15, 0.2);
    transition-property: border-color;
    transition-duration: 0.3s;
}

.mp-mode-card:hover .mp-mode-inner-border {
    border-color: rgba(217, 119, 6, 0.4);
}

/* Corners */
.mp-mode-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: rgba(146, 64, 14, 0.4);
    transition-property: border-color;
    transition-duration: 0.3s;
}

.mp-mode-card:hover .mp-mode-corner {
    border-color: rgb(245, 158, 11);
}

.mp-mode-corner-tl { left: 12px; top: 12px; border-left-width: 1px; border-top-width: 1px; }
.mp-mode-corner-tr { right: 12px; top: 12px; border-right-width: 1px; border-top-width: 1px; }
.mp-mode-corner-bl { left: 12px; bottom: 12px; border-left-width: 1px; border-bottom-width: 1px; }
.mp-mode-corner-br { right: 12px; bottom: 12px; border-right-width: 1px; border-bottom-width: 1px; }

/* Numeral */
.mp-mode-numeral {
    font-size: 12px;
    color: rgba(180, 83, 9, 0.6);
    letter-spacing: 4px;
    transition-property: color;
    transition-duration: 0.3s;
}

.mp-mode-card:hover .mp-mode-numeral {
    color: rgb(245, 158, 11);
}

/* Title */
.mp-mode-title {
    font-size: 16px;
    color: rgb(254, 243, 199);
    letter-spacing: 6px;
    margin-top: 8px;
}

/* Icon */
.mp-mode-icon-section {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.mp-mode-icon-glow {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(245, 158, 11, 0);
    transition-property: background-color;
    transition-duration: 0.4s;
}

.mp-mode-card:hover .mp-mode-icon-glow {
    background-color: rgba(245, 158, 11, 0.12);
}

.mp-mode-icon-glow-ranked {
    background-color: rgba(220, 38, 38, 0.03);
}

.mp-mode-card:hover .mp-mode-icon-glow-ranked {
    background-color: rgba(220, 38, 38, 0.12);
}

.mp-mode-icon {
    font-size: 48px;
    color: rgb(180, 83, 9);
    -unity-text-align: middle-center;
    transition-property: color;
    transition-duration: 0.3s;
}

.mp-mode-card:hover .mp-mode-icon {
    color: rgb(251, 191, 36);
}

/* Ranked card special border */
.mp-mode-ranked {
    border-color: rgba(220, 38, 38, 0.3);
}

.mp-mode-ranked:hover {
    border-color: rgb(248, 113, 113);
}

.mp-mode-ranked .mp-mode-corner {
    border-color: rgba(220, 38, 38, 0.3);
}

.mp-mode-ranked:hover .mp-mode-corner {
    border-color: rgb(248, 113, 113);
}

.mp-mode-ranked .mp-mode-numeral {
    color: rgba(220, 38, 38, 0.5);
}

.mp-mode-ranked:hover .mp-mode-numeral {
    color: rgb(248, 113, 113);
}

.mp-mode-ranked .mp-mode-icon {
    color: rgba(220, 38, 38, 0.6);
}

.mp-mode-ranked:hover .mp-mode-icon {
    color: rgb(248, 113, 113);
}

/* Description */
.mp-mode-desc {
    font-size: 10px;
    color: rgba(245, 158, 11, 0.4);
    letter-spacing: 2px;
    -unity-text-align: upper-center;
}

.mp-mode-subdesc {
    font-size: 9px;
    color: rgba(200, 210, 220, 0.25);
    letter-spacing: 2px;
    -unity-text-align: upper-center;
    margin-top: 2px;
    margin-bottom: 8px;
}

/* Hover line */
.mp-mode-hover-line {
    position: absolute;
    bottom: 0;
    left: 25%;
    right: 25%;
    height: 2px;
    background-color: rgb(245, 158, 11);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.mp-mode-card:hover .mp-mode-hover-line {
    opacity: 1;
}

.mp-mode-ranked .mp-mode-hover-line {
    background-color: rgb(248, 113, 113);
}

/* Disabled state */
.mp-mode-disabled {
    opacity: 0.4;
}

.mp-mode-disabled:hover {
    scale: 1 1;
    translate: 0 0;
    border-color: rgba(146, 64, 14, 0.4);
}

.mp-mode-lock-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.mp-mode-lock-text {
    font-size: 11px;
    color: rgba(248, 113, 113, 0.6);
    letter-spacing: 4px;
}


/* ============================================
   LOADING OVERLAY
   ============================================ */

.mp-loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

.mp-loading-box {
    width: 400px;
    align-items: center;
    padding: 40px;
}

.mp-loading-title {
    font-size: 16px;
    color: rgb(254, 243, 199);
    letter-spacing: 8px;
    margin-bottom: 32px;
}

.mp-loading-bar-bg {
    width: 100%;
    height: 4px;
    background-color: rgba(245, 158, 11, 0.1);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 12px;
}

.mp-loading-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(245, 158, 11);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.3s;
}

.mp-loading-text {
    font-size: 11px;
    color: rgba(245, 158, 11, 0.4);
    letter-spacing: 3px;
}

/* ============================================
   BOTTOM BAR
   ============================================ */

.bottom-info-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 12px 40px;
    background-color: rgba(8, 12, 20, 0.7);
    border-top-width: 1px;
    border-top-color: rgba(245, 158, 11, 0.06);
}

.bottom-info-text {
    font-size: 10px;
    color: rgba(245, 158, 11, 0.25);
    letter-spacing: 3px;
}

.hidden { display: none; }